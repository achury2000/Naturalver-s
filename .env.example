# ============================================================================
# NATURALVER'S — Plantilla de variables de entorno (PRODUCCIÓN)
#
# deploy-prod.sh copia este archivo a .env si no existe, y luego ABORTA si
# encuentra algún secreto sin rellenar (valor vacío o que empiece por YOUR_).
#
# Variables detectadas leyendo el código:
#   PAYLOAD_SECRET              -> payload.config.ts   (secreto, obligatorio)
#   MONGODB_URI                 -> payload.config.ts   (compose lo inyecta)
#   NEXT_PUBLIC_SITE_URL        -> payload.config.ts, next.config.js
#   NEXT_PUBLIC_PAYLOAD_API_URL -> lib/payload.ts (client)
#   NEXT_PUBLIC_WHATSAPP_NUMBER -> lib/whatsapp.ts (client, build-time)
#   APP_PORT                    -> puerto del host, sólo compose/deploy
#   MONGO_DB_NAME               -> nombre de la BD, sólo compose/deploy
# ============================================================================

# ---------------------------------------------------------------------------
# Payload CMS — SECRETO OBLIGATORIO
# ---------------------------------------------------------------------------
# Genera uno con: openssl rand -base64 48
# Cualquier cadena aleatoria larga y única.
# Payload sólo lanza error si el secreto falta o está VACÍO (no rechaza
# explícitamente el valor por defecto del repo), pero ese secreto es la base
# del hash con el que se firman los JWT y las cookies de admin: con uno
# débil o público, las sesiones del admin son falsificables. Además, cambiarlo
# invalida las sesiones ya iniciadas.
PAYLOAD_SECRET=YOUR_PAYLOAD_SECRET

# ---------------------------------------------------------------------------
# MongoDB
# ---------------------------------------------------------------------------
# IMPORTANTE: la app lee MONGODB_URI, no DATABASE_URI (ver payload.config.ts).
# compose.prod.yaml SOBREESCRIBE este valor para apuntar al servicio interno,
# así que déjalo como referencia: no hace falta cambiarlo para desplegar.
# Si activas autenticación en Mongo, pasa a:
#   mongodb://USUARIO:PASSWORD@mongo:27017/naturalvers?authSource=admin
MONGODB_URI=mongodb://mongo:27017/naturalvers

# Nombre de la base de datos (usado para componer MONGODB_URI en compose).
MONGO_DB_NAME=naturalvers

# ---------------------------------------------------------------------------
# Next.js
# ---------------------------------------------------------------------------
# Debe ser la URL PÚBLICA y ABSOLUTA por la que se alcanzará el sitio.
# Payload la usa como serverURL (firma enlaces del admin y genera URLs
# absolutas de media), y next.config.js la usa para autorizar las imágenes
# de /api/media/** en next/image.
# Sigue siendo http:// durante el despliegue; pon https:// si publicas
# detrás de un proxy inverso con TLS.
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Prefijo del API de Payload. Déjalo en /api salvo que montes Payload
# en otra ruta.
NEXT_PUBLIC_PAYLOAD_API_URL=/api

# ---------------------------------------------------------------------------
# Checkout por WhatsApp
# ---------------------------------------------------------------------------
# DÍGITOS SOLOS, con código de país, sin +, sin espacios ni guiones.
# Ej: 57 310 619 8912 -> 573106198912
# Si lo dejas vacío el checkout sigue funcionando: el pedido se guarda y se
# avisa al cliente de que el contacto no está disponible.
# IMPORTANTE: se compila dentro del bundle del cliente (build-time). Cambiarlo
# en .env exige volver a construir la imagen.
NEXT_PUBLIC_WHATSAPP_NUMBER=573106198912

# ---------------------------------------------------------------------------
# Puerto
# ---------------------------------------------------------------------------
# Puerto en el HOST donde se publica la app. Dentro del contenedor siempre
# coincide con APP_PORT. Cámbialo si el 3000 ya está ocupado.
APP_PORT=3000

# ============================================================================
# Variables que NO usa ninguna parte del código (confirmado por búsqueda)
# ------------------------------------------------------------------------===
# EMAIL_HOST, EMAIL_PORT, EMAIL_USER, EMAIL_PASS y EMAIL_FROM aparecen en el
# .env.example anterior pero NADA las lee: el proyecto no tiene adaptador de
# email configurado (payload.config.ts no registra ningún adapter de email, y
# Payload sólo emite un warning al arrancar). Se dejan comentadas para no
# hacer perder tiempo rellenándolas. Cuando se conecte un adaptador real
# (resend, nodemailer, sendgrid...) hay que descomentarlas Y añadir el
# adapter en payload.config.ts.
# NEXT_PUBLIC_SITE_NAME tampoco la lee ningún archivo.
#
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USER=YOUR_EMAIL_USER
# EMAIL_PASS=YOUR_EMAIL_APP_PASSWORD
# EMAIL_FROM=noreply@naturalvers.com
